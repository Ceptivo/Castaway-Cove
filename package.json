{
  "name": "castaway-cove",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "assets": "python3 tools/build_assets.py",
    "screens": "node tools/screenshots.mjs",
    "cap:sync": "npm run build && cap sync android",
    "web-page": "npm run build && node tools/build_web_page.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "playwright-core": "^1.64.1",
    "typescript": "5.9",
    "vite": "^7.3.7"
  }
}
